{
  "version": "1.0.0",
  "tools": [
    {
      "name": "check_service",
      "description": "Side effects: read. Required inputs: service_name. Result: operational status, optional incident ID, and check time. Sensitive data: none. Approval: none.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "check_service",
            "default": "check_service",
            "title": "Kind",
            "type": "string"
          },
          "service_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Service Name",
            "type": "string"
          }
        },
        "required": [
          "service_name"
        ],
        "title": "CheckServiceArgs",
        "type": "object"
      },
      "result_schema": {
        "$defs": {
          "ServiceStatus": {
            "enum": [
              "operational",
              "degraded",
              "outage"
            ],
            "title": "ServiceStatus",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "check_service",
            "default": "check_service",
            "title": "Kind",
            "type": "string"
          },
          "service_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Service Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/ServiceStatus"
          },
          "incident_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Incident Id"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          }
        },
        "required": [
          "service_name",
          "status",
          "checked_at"
        ],
        "title": "CheckServiceResult",
        "type": "object"
      },
      "side_effects": "read",
      "risk_level": "low",
      "idempotent": true,
      "timeout_s": 5.0
    },
    {
