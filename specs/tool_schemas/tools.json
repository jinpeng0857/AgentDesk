            "maxLength": 128,
            "minLength": 1,
            "title": "Requester Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "source_ticket_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Ticket Id",
            "type": "string"
          }
        },
        "required": [
          "requester_id",
          "title",
          "description",
          "source_ticket_id"
        ],
        "title": "CreateTicketArgs",
        "type": "object"
      },
      "result_schema": {
        "$defs": {
          "WriteResultStatus": {
            "enum": [
              "created",
              "accepted",
              "succeeded"
            ],
            "title": "WriteResultStatus",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "create_ticket",
            "default": "create_ticket",
            "title": "Kind",
            "type": "string"
          },
          "downstream_ticket_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Downstream Ticket Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/WriteResultStatus"
          }
        },
        "required": [
          "downstream_ticket_id",
          "status"
        ],
        "title": "CreateTicketResult",
        "type": "object"
      },
      "side_effects": "write",
      "risk_level": "low",
      "idempotent": true,
      "timeout_s": 5.0
    },
    {
      "name": "process_refund",
      "description": "Side effects: write. Required inputs: requester_id, order_id, amount, currency, and order_version. Result: refund ID, status, amount, and currency. Sensitive data: order and requester details must be redacted in audit. Approval: Policy is required; amount at or above 200.00 USD requires a human.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "process_refund",
            "default": "process_refund",
            "title": "Kind",
            "type": "string"
          },
          "requester_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Requester Id",
            "type": "string"
          },
          "order_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Order Id",
            "type": "string"
          },
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          },
          "order_version": {
            "minimum": 1,
            "title": "Order Version",
            "type": "integer"
          }
        },
        "required": [
          "requester_id",
          "order_id",
          "amount",
          "currency",
          "order_version"
        ],
        "title": "ProcessRefundArgs",
        "type": "object"
      },
      "result_schema": {
        "$defs": {
          "WriteResultStatus": {
            "enum": [
              "created",
              "accepted",
              "succeeded"
            ],
            "title": "WriteResultStatus",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "process_refund",
            "default": "process_refund",
            "title": "Kind",
            "type": "string"
          },
          "refund_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Refund Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/WriteResultStatus"
          },
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)",
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "refund_id",
          "status",
          "amount",
          "currency"
        ],
        "title": "ProcessRefundResult",
        "type": "object"
      },
      "side_effects": "write",
      "risk_level": "medium",
      "idempotent": true,
      "timeout_s": 10.0
    },
