    {
      "name": "search_knowledge",
      "description": "Side effects: read. Required inputs: query and top_k. Result: ranked knowledge references with document and chunk identifiers. Sensitive data: none; indexed cases must already be redacted. Approval: none.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "search_knowledge",
            "default": "search_knowledge",
            "title": "Kind",
            "type": "string"
          },
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 10,
            "minimum": 1,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchKnowledgeArgs",
        "type": "object"
      },
      "result_schema": {
        "$defs": {
          "KnowledgeSearchItem": {
            "additionalProperties": false,
            "properties": {
              "document_id": {
                "maxLength": 128,
                "minLength": 1,
                "title": "Document Id",
                "type": "string"
              },
              "chunk_id": {
                "maxLength": 128,
                "minLength": 1,
                "title": "Chunk Id",
                "type": "string"
              },
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "content_excerpt": {
                "maxLength": 1000,
                "minLength": 1,
                "title": "Content Excerpt",
                "type": "string"
              },
              "score": {
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Score",
                "type": "number"
              }
            },
            "required": [
              "document_id",
              "chunk_id",
              "title",
              "content_excerpt",
              "score"
            ],
            "title": "KnowledgeSearchItem",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "search_knowledge",
            "default": "search_knowledge",
            "title": "Kind",
            "type": "string"
          },
          "refs": {
            "items": {
              "$ref": "#/$defs/KnowledgeSearchItem"
            },
            "title": "Refs",
            "type": "array"
          }
        },
        "required": [
          "refs"
        ],
        "title": "SearchKnowledgeResult",
        "type": "object"
      },
      "side_effects": "read",
      "risk_level": "low",
      "idempotent": true,
