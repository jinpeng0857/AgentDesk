            "maxLength": 128,
            "minLength": 1,
            "title": "User Id",
            "type": "string"
          },
          "account_version": {
            "minimum": 1,
            "title": "Account Version",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "account_version"
        ],
        "title": "ResetPasswordArgs",
        "type": "object"
      },
      "result_schema": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "reset_password",
            "default": "reset_password",
            "title": "Kind",
            "type": "string"
          },
          "user_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id",
